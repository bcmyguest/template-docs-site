{
  "name": "template-docs-site-site",
  "version": "0.0.0",
  "description": "Docs site for template-docs-site (Astro + Starlight).",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "theme": "node scripts/gen-theme.mjs",
    "dev": "node scripts/sync.mjs && node scripts/gen-theme.mjs && astro dev",
    "build": "node scripts/sync.mjs && node scripts/gen-theme.mjs && astro build && node scripts/check-links.mjs dist",
    "check:links": "node scripts/check-links.mjs dist",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.11",
    "@fontsource/dm-sans": "^5.3.0",
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  }
}
